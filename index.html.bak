<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>BitWave — a register you can see</title>
<style>
  :root {
    --bg:        #08090c;
    --panel:     #0d1015;
    --panel-hi:  #12161d;
    --line:      #1b212b;
    --line-soft: #141920;
    --text:      #e8edf5;
    --dim:       #67728a;
    --dimmer:    #3f4859;
    --accent:    #34d399;
    --accent-hi: #5eead4;
    --accent-low:#22c55e;
    --panel-hover:#181d26;
    --line-hi:   #2a3341;
    --inf:       #f5b544;
    --stage-glow:#0b0e13;
    --handle-hi: #eafaf3;
    --pad:       40px;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }

  html, body { height: 100%; }

  body {
    margin: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto;
    grid-template-columns: minmax(0, 1fr);
  }

  /* ── header ───────────────────────────────────────────── */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--pad) 14px;
    border-bottom: 1px solid var(--line-soft);
  }

  .title { display: flex; align-items: baseline; gap: 12px; min-width: 0; }

  h1 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .title p {
    margin: 0;
    font-size: 12px;
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sizer { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; }

  .sizer label {
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dimmer);
  }

  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: clamp(110px, 16vw, 190px);
    height: 22px;
    background: transparent;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--line);
    border-radius: 2px;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--accent);
  }

  input[type="range"]::-moz-range-track {
    height: 2px;
    background: var(--line);
    border-radius: 2px;
  }

  input[type="range"]::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--accent);
  }

  input[type="range"]:focus-visible { outline: none; }
  input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 4px rgba(52,211,153,0.25); }

  #sizeOut {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
    min-width: 132px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* ── wave stage ───────────────────────────────────────── */
  .stage {
    position: relative;
    min-height: 0;
    background: radial-gradient(120% 90% at 50% 45%, var(--stage-glow) 0%, var(--bg) 70%);
  }

  #wave {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }

  #wave.grabbing { cursor: grabbing; }

  .hint {
    position: absolute;
    left: 50%;
    top: 10px;
    transform: translateX(-50%);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dimmer);
    pointer-events: none;
    user-select: none;
    transition: opacity 220ms ease;
  }

  .hint.off { opacity: 0; }

  /* ── bit strip ────────────────────────────────────────── */
  .strip {
    position: relative;
    border-top: 1px solid var(--line-soft);
    background: var(--panel);
    padding: 12px 0 10px;
    overflow-x: auto;
    overflow-y: hidden;
  }

  /* Which register the strip is showing. */
  .strip::before {
    content: attr(data-edit);
    position: absolute;
    left: 5px;
    top: 13px;
    font-family: var(--mono);
    font-size: 9px;
    color: var(--dimmer);
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .nibs {
    display: flex;
    margin: 0 var(--pad);
    font-family: var(--mono);
    font-size: 13px;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Each nibble flexes to an equal share of the plot width. The
     gutter is a real flex `gap` set from JS (percentage padding
     resolves against the container and refuses to shrink), so the
     canvas can mirror the exact same column geometry. */
  .nib {
    flex: 1 1 0;
    min-width: 0;
    padding: 2px 0 3px;
    border-radius: 3px;
  }

  .nib.hot { background: rgba(52,211,153,0.07); }

  /* The bit glyphs keep a natural monospace pitch and stay centred in
     the nibble, rather than stretching when a register has few nibbles
     (2 nibbles would otherwise scatter the digits 166px apart). */
  .bits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: min(100%, 5.2ch);
    margin-inline: auto;
  }

  .bit {
    text-align: center;
    font-size: 0.86em;
    line-height: 1.55;
    color: var(--dimmer);
    cursor: pointer;
    border-radius: 2px;
    transition: color 90ms linear, background-color 90ms linear;
  }

  .bit.on { color: var(--accent); }
  .bit:hover { background: var(--panel-hi); }
  .bit.mid { box-shadow: inset 0 -2px 0 rgba(245,181,68,0.55); }

  .hex {
    text-align: center;
    font-size: 0.76em;
    line-height: 1.65;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  /* A nibble's own value in decimal (0–15) — its share of the vertical axis. */
  .dec {
    text-align: center;
    font-size: 0.68em;
    line-height: 1.45;
    color: var(--dimmer);
    font-variant-numeric: tabular-nums;
  }

  /* The place value of the position: what its LSB is worth.
     Structural, not data — so it stays quieter than the value above it. */
  .wt {
    text-align: center;
    font-size: 0.62em;
    line-height: 1.5;
    color: var(--dimmer);
    opacity: 0.75;
    white-space: nowrap;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .strip.compact .bits { display: none; }
  .strip.compact .hex { font-size: 0.86em; color: var(--text); line-height: 1.95; }
  .strip.compact .dec { font-size: 0.6em; line-height: 1.35; }
  .strip.compact .wt { font-size: 0.66em; }

  /* ── meta readout ─────────────────────────────────────── */
  .meta {
    display: flex;
    align-items: center;
    gap: 10px 22px;
    flex-wrap: wrap;
    padding: 9px var(--pad);
    border-top: 1px solid var(--line-soft);
    background: var(--panel);
    font-family: var(--mono);
    font-size: 11.5px;
  }

  .meta.ab .aOnly { display: none; }
  .meta:not(.ab) .abOnly { display: none; }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--accent);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge.flat { color: var(--dim); }

  .kv { display: flex; align-items: baseline; gap: 8px; min-width: 0; }

  .kv > span {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dimmer);
  }

  .kv code {
    font-family: var(--mono);
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .kv.wide { flex: 1 1 260px; min-width: 0; }
  .kv.wide code { display: block; max-width: 100%; }

  /* ── truth table ──────────────────────────────────────── */
  .truth {
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.35;
    padding: 3px 9px 4px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--panel-hi);
  }

  .truth-h {
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--dim);
    margin-bottom: 2px;
    white-space: nowrap;
  }

  .truth-grid {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 0 11px;
    align-items: baseline;
  }

  .truth-grid > span { text-align: center; font-variant-numeric: tabular-nums; }
  .truth-grid > .th {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .truth-grid > .z { color: var(--dim); }
  .truth-grid > .z.on { color: var(--accent); }
  /* The count column is data about the register, not part of the
     algebra — a rule keeps the four logic cells from reading as one run. */
  .truth-grid > .ct {
    color: var(--text);
    border-left: 1px solid var(--line);
    padding-left: 9px;
  }

  /* Arithmetic ops have no 4-row truth table — they get a 2-column summary. */
  .truth-grid.ar {
    grid-template-columns: auto auto;
    gap: 0 14px;
  }
  .truth-grid.ar > .th { text-align: left; }
  .truth-grid.ar > .ct { text-align: left; border-left-width: 0; padding-left: 0; }
  .truth-grid.ar > .ct.yes { color: var(--inf); }

  /* ── controls ─────────────────────────────────────────── */
  .controls {
    display: flex;
    align-items: center;
    gap: 10px 26px;
    flex-wrap: wrap;
    padding: 11px var(--pad) 14px;
    border-top: 1px solid var(--line);
    background: var(--panel);
  }

  .group { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }

  .group > label {
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dimmer);
    margin-right: 1px;
  }

  button.op {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text);
    background: var(--panel-hi);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 5px 10px;
    cursor: pointer;
    transition: background-color 110ms linear, border-color 110ms linear, color 110ms linear;
  }

  button.op:hover { background: var(--panel-hover); border-color: var(--line-hi); }
  button.op:active { transform: translateY(0.5px); }
  button.op:focus-visible { outline: none; box-shadow: 0 0 0 2px rgba(52,211,153,0.35); }
  button.op.accent { color: var(--accent); border-color: rgba(52,211,153,0.28); }
  button.op.accent:hover { border-color: rgba(52,211,153,0.5); }

  button.op.on,
  button.op[aria-pressed="true"] {
    color: var(--accent);
    border-color: rgba(52,211,153,0.5);
    background: rgba(52,211,153,0.10);
  }

  /* segmented A | B */
  .seg { display: flex; }
  .seg .op { border-radius: 0; padding: 5px 9px; }
  .seg .op:first-child { border-radius: 5px 0 0 5px; }
  .seg .op:last-child { border-radius: 0 5px 5px 0; border-left-width: 0; }

  select {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text);
    background: var(--panel-hi);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 5px 6px;
    cursor: pointer;
  }

  select:focus-visible { outline: none; box-shadow: 0 0 0 2px rgba(52,211,153,0.35); }

  .spacer { flex: 1 1 0; }

  .excount {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    min-width: 54px;
    text-align: center;
  }

  @media (max-width: 720px) {
    :root { --pad: 16px; }
    header { flex-wrap: wrap; gap: 12px; padding-top: 12px; padding-bottom: 12px; }
    .title p { display: none; }
    .sizer { width: 100%; }
    .sizer input[type="range"] { flex: 1 1 auto; width: auto; }
    #sizeOut { min-width: 0; }
    .controls { gap: 8px 16px; }
    .kv.wide { flex-basis: 100%; }
    .strip::before { top: 8px; }
  }
</style>
</head>
<body>

<header>
  <div class="title">
    <h1>BitWave</h1>
    <p>registers as waveforms — every nibble is a sample</p>
  </div>
  <div class="sizer">
    <label for="size">register</label>
    <input id="size" type="range" min="0" max="5" step="1" value="3" aria-label="Register size" />
    <output id="sizeOut" for="size">64 bits · 16 nibbles</output>
  </div>
</header>

<section class="stage">
  <canvas id="wave"></canvas>
  <div class="hint" id="hint">drag a nibble up or down</div>
</section>

<section class="strip" id="strip" data-edit="A">
  <div class="nibs" id="nibs"></div>
</section>

<section class="meta" id="meta">
  <div class="badge" id="trend">level</div>

  <div class="aOnly kv"><span>hex</span><code id="hex">—</code></div>
  <div class="aOnly kv wide"><span>dec</span><code id="dec">—</code></div>

  <div class="abOnly truth" id="truth"></div>
  <div class="abOnly kv"><span>A</span><code id="hexA">—</code></div>
  <div class="abOnly kv"><span>B</span><code id="hexB">—</code></div>
  <div class="abOnly kv"><span>Z</span><code id="hexZ">—</code></div>
  <div class="abOnly kv"><span>pop z</span><code id="pop">—</code></div>
</section>

<section class="controls">
  <div class="group">
    <label>data</label>
    <button class="op" id="csvBtn" title="Import a CSV or TSV of examples">import csv</button>
    <input type="file" id="csvFile" accept=".csv,.tsv,text/csv,text/plain" hidden />
    <div class="seg" id="stepSeg" hidden>
      <button class="op" id="prevEx" title="Previous example (←)">◀</button>
      <button class="op" id="nextEx" title="Next example (→)">▶</button>
    </div>
    <span class="excount" id="exCount" hidden>0 / 0</span>
    <select id="colA" hidden aria-label="Register A column"></select>
    <select id="colB" hidden aria-label="Register B column"></select>
  </div>

  <div class="group">
    <label>table</label>
    <button class="op" data-preset="zero">0</button>
    <button class="op" data-preset="max">F</button>
    <button class="op" data-preset="sine">sine</button>
    <button class="op" data-preset="cosine">cosine</button>
    <button class="op" data-preset="triangle">tri</button>
    <button class="op" data-preset="sawDown">saw ↓</button>
    <button class="op" data-preset="sawUp">saw ↑</button>
    <button class="op" data-preset="square">square</button>
  </div>

  <div class="group">
    <label>logic</label>
    <button class="op" id="toggleB" aria-pressed="false" title="Add a second operand register">B</button>
    <div class="seg" id="editSeg" hidden>
      <button class="op on" data-edit="a" title="Edit A">A</button>
      <button class="op" data-edit="b" title="Edit B">B</button>
    </div>
    <button class="op accent" data-binop="and" hidden>AND</button>
    <button class="op accent" data-binop="or" hidden>OR</button>
    <button class="op accent" data-binop="xor" hidden>XOR</button>
    <button class="op accent" data-binop="add" hidden title="Arithmetic add — carries propagate">ADD</button>
    <button class="op accent" data-binop="sub" hidden title="Arithmetic subtract — borrows propagate">SUB</button>
  </div>

  <div class="group">
    <label>view</label>
    <div class="seg" id="viewSeg">
      <button class="op on" data-view="2d">2D</button>
      <button class="op" data-view="3d" title="A and B as wavetable frames, result between them">3D</button>
    </div>
  </div>

  <div class="group">
    <label>lfo</label>
    <button class="op" id="lfoBtn" aria-pressed="false" title="Animate the register you are editing">LFO</button>
    <select id="lfoMode" aria-label="LFO motion">
      <option value="rotcw">rot ↻</option>
      <option value="rotccw">rot ↺</option>
      <option value="slide">slide ⇄</option>
    </select>
    <select id="lfoRate" aria-label="LFO rate">
      <option value="1">1/s</option>
      <option value="2">2/s</option>
      <option value="4" selected>4/s</option>
      <option value="8">8/s</option>
    </select>
    <select id="lfoB" aria-label="B phase relative to A">
      <option value="0">b sync</option>
      <option value="opp">b anti</option>
      <option value="q">b +¼</option>
      <option value="h">b +½</option>
    </select>
  </div>

  <div class="group">
    <label>op</label>
    <select id="amount" aria-label="Rotate / shift amount in bits">
      <option value="1">1 bit</option>
      <option value="2">2 bits</option>
      <option value="4" selected>4 bits</option>
      <option value="8">8 bits</option>
    </select>
    <button class="op accent" data-op="rol">ROL ←</button>
    <button class="op accent" data-op="ror">ROR →</button>
    <button class="op accent" data-op="shl">SHL ←</button>
    <button class="op accent" data-op="shr">SHR →</button>
    <button class="op accent" data-op="not">NOT</button>
    <button class="op accent" data-op="fold">FOLD</button>
    <button class="op accent" data-op="bswap" title="Reverse byte order — endianness swap">BSWAP</button>
  </div>
</section>

<script>
(() => {
  "use strict";

  /* ══════════════════════════════════════════════════════════
     MODEL
     bits[0] is the LSB (hardware convention).
     Screen column c maps to bit index  N - 1 - c   (MSB on the left).
     Nibble j is the j-th group from the left, so it covers
     bit indices  N-1-4j  down to  N-4-4j.

     Three registers:
       A, B — operands, editable
       Z    — derived result of A <binop> B, never edited directly
     ══════════════════════════════════════════════════════════ */

  const SIZES = [8, 16, 32, 64, 128, 256];

  const makeReg = (N) => {
    const n = N >> 2;
    return {
      bits: new Uint8Array(N),
      anim: new Array(n).fill(0),    // rendered nibble values (floats, eased)
      target: new Array(n).fill(0),  // settled nibble values (ints)
    };
  };

  const S = {
    N: 64,
    A: makeReg(64),
    B: makeReg(64),
    Z: makeReg(64),
    showB: false,
    binop: "xor",
    edit: "a",           // "a" | "b" — which operand drags/presets act on
    seededB: false,
    compact: false,
    view3d: false,
    lfo: { on: false, mode: "rotcw", rate: 4, t: 0, base: null },
    lfoAcc: 0,
    drag: -1,
    hoverReg: null,
    hoverJ: -1,
  };

  const nibCount = () => S.N >> 2;

  /* Place value of nibble j (0 = MSB): the exponent of two that its LSB is
     worth. A constant of the *position* — 4 less for every step right, since
     each step is one hex digit — and wholly independent of what the other
     nibbles hold. Contribution = nibbleValue * 2^weight. */
  const nibWeightPow = (j) => 4 * (nibCount() - 1 - j);

  const regOf = (k) => (k === "b" ? S.B : k === "z" ? S.Z : S.A);
  const editKey = () => (S.showB && S.edit === "b" ? "b" : "a");
  const editReg = () => regOf(editKey());

  function nibAt(bits, j) {
    const b = S.N - 1 - 4 * j;
    return (bits[b] << 3) | (bits[b - 1] << 2) | (bits[b - 2] << 1) | bits[b - 3];
  }

  function setNibAt(bits, j, v) {
    const b = S.N - 1 - 4 * j;
    bits[b]     = (v >> 3) & 1;
    bits[b - 1] = (v >> 2) & 1;
    bits[b - 2] = (v >> 1) & 1;
    bits[b - 3] = v & 1;
  }

  const nibValue = (r, j) => nibAt(r.bits, j);
  const setNibValue = (r, j, v) => setNibAt(r.bits, j, v);

  function syncTarget(r, instant = false) {
    const n = nibCount();
    if (r.target.length !== n) {
      r.target = new Array(n);
      r.anim = new Array(n);
    }
    for (let j = 0; j < n; j++) r.target[j] = nibValue(r, j);
    if (instant) r.anim = r.target.slice();
  }

  /* Arithmetic ops (ADD / SUB) need the whole word, so they go through
     BigInt. BigInt `&` is two's complement over infinite sign extension,
     which makes the mod-2^N wrap correct even for negative results. */
  const isArith = () => S.binop === "add" || S.binop === "sub";

  function regToBig(r) {
    let v = 0n;
    for (let i = S.N - 1; i >= 0; i--) v = (v << 1n) | BigInt(r.bits[i]);
    return v;
  }

  function bigToReg(v, r) {
    const mask = (1n << BigInt(S.N)) - 1n;
    v &= mask;
    for (let i = 0; i < S.N; i++) { r.bits[i] = Number(v & 1n); v >>= 1n; }
  }

  /* Z is always A <op> B.
     Bitwise ops work bit for bit; ADD/SUB carry and borrow across the word —
     which is precisely why neither equals XOR. */
  function recomputeZ(instant = false) {
    const op = S.binop;

    if (op === "add" || op === "sub") {
      const a = regToBig(S.A);
      const b = regToBig(S.B);
      bigToReg(op === "add" ? a + b : a - b, S.Z);
    } else {
      const a = S.A.bits, b = S.B.bits, z = S.Z.bits;
      for (let i = 0; i < S.N; i++) {
        const x = a[i], y = b[i];
        z[i] = op === "and" ? (x & y) : op === "or" ? (x | y) : (x ^ y);
      }
    }
    syncTarget(S.Z, instant);
  }

  /* Grow / shrink around the centre: the outermost nibbles on each side
     stay pinned and new nibbles appear at the ∞ point. */
  function resizeRegister(newN) {
    if (newN === S.N) return;
    lfoStop();                       // its snapshot belongs to the old width

    const oldN = S.N;
    const oldNibs = oldN >> 2;
    const newNibs = newN >> 2;
    const keep = Math.min(oldNibs, newNibs) >> 1;

    const remap = (r) => {
      const oldVals = new Array(oldNibs);
      for (let j = 0; j < oldNibs; j++) oldVals[j] = nibAt(r.bits, j);
      const vals = new Array(newNibs).fill(0);
      for (let k = 0; k < keep; k++) {
        vals[k] = oldVals[k];                               // MSB side
        vals[newNibs - 1 - k] = oldVals[oldNibs - 1 - k];   // LSB side
      }
      return vals;
    };

    const valsA = remap(S.A);
    const valsB = remap(S.B);

    S.N = newN;

    for (const [r, vals] of [[S.A, valsA], [S.B, valsB]]) {
      r.bits = new Uint8Array(newN);
      r.target = vals.slice();
      r.anim = vals.slice();
      for (let j = 0; j < newNibs; j++) setNibAt(r.bits, j, vals[j]);
    }
    S.Z.bits = new Uint8Array(newN);
    S.Z.target = new Array(newNibs).fill(0);
    S.Z.anim = new Array(newNibs).fill(0);

    S.drag = -1;
    S.hoverReg = null;
    S.hoverJ = -1;

    recomputeZ(true);
    renderStrip();
    updateReadouts();
  }

  /* ══════════════════════════════════════════════════════════
     SPLINE — monotone cubic Hermite, flat at both ends.
     Flat end tangents are what give the reference curves their
     level shoulders; with two control points it degenerates to
     smoothstep, which is exactly the sketch.
     ══════════════════════════════════════════════════════════ */

  function buildSpline(xs, ys) {
    const n = xs.length;
    const h = new Array(n - 1);
    const d = new Array(n - 1);
    const m = new Array(n);

    for (let i = 0; i < n - 1; i++) {
      h[i] = xs[i + 1] - xs[i];
      d[i] = h[i] === 0 ? 0 : (ys[i + 1] - ys[i]) / h[i];
    }

    m[0] = 0;
    m[n - 1] = 0;

    for (let i = 1; i < n - 1; i++) {
      if (d[i - 1] * d[i] <= 0) {
        m[i] = 0;                                     // local extremum → level off
      } else {
        const w1 = 2 * h[i] + h[i - 1];               // Fritsch–Butland weighting
        const w2 = h[i] + 2 * h[i - 1];
        m[i] = (w1 + w2) / (w1 / d[i - 1] + w2 / d[i]);
      }
    }
    return { xs, ys, m, h, n };
  }

  function evalSpline(sp, x) {
    const { xs, ys, m, h, n } = sp;
    if (x <= xs[0]) return ys[0];
    if (x >= xs[n - 1]) return ys[n - 1];

    let i = 0;
    while (i < n - 2 && x > xs[i + 1]) i++;

    const t = (x - xs[i]) / h[i];
    const t2 = t * t;
    const t3 = t2 * t;

    return (2 * t3 - 3 * t2 + 1) * ys[i]
         + (t3 - 2 * t2 + t) * h[i] * m[i]
         + (-2 * t3 + 3 * t2) * ys[i + 1]
         + (t3 - t2) * h[i] * m[i + 1];
  }

  /* ══════════════════════════════════════════════════════════
     RENDER — canvas
     ══════════════════════════════════════════════════════════ */

  const canvas = document.getElementById("wave");
  const ctx = canvas.getContext("2d");
  const MONO = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

  /* Canvas can't read CSS vars directly — resolve the few it needs once
     so retheming stays a :root-only edit. */
  const ROOT = getComputedStyle(document.documentElement);
  const C_ACCENT = ROOT.getPropertyValue("--accent").trim() || "#34d399";
  const C_ACCENT_HI = ROOT.getPropertyValue("--accent-hi").trim() || "#5eead4";
  const C_ACCENT_LOW = ROOT.getPropertyValue("--accent-low").trim() || "#22c55e";
  const C_DIMMER = ROOT.getPropertyValue("--dimmer").trim() || "#3f4859";
  const C_HANDLE_HI = ROOT.getPropertyValue("--handle-hi").trim() || "#eafaf3";

  /* Turn a hex token into rgba() so canvas fills stay token-driven. */
  function rgbaToken(hex, a) {
    const h = hex.replace("#", "");
    const full = h.length === 3 ? h.split("").map((c) => c + c).join("") : h;
    const n = parseInt(full, 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }

  let VW = 0, VH = 0;
  let G = { x0: 0, x1: 0, y0: 0, y1: 0, pw: 0, ph: 0, nibW: 0, nibGap: 0, spA: null, spB: null };

  function fitCanvas() {
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    VW = Math.max(1, Math.round(r.width));
    VH = Math.max(1, Math.round(r.height));
    canvas.width = Math.round(VW * dpr);
    canvas.height = Math.round(VH * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // Keep the bit strip's gutter identical to the plot's gutter.
    document.documentElement.style.setProperty("--pad", (VW < 680 ? 16 : 40) + "px");
  }

  function strokeCurve(sp, x0, x1) {
    ctx.beginPath();
    const steps = Math.max(2, Math.ceil(x1 - x0));
    for (let s = 0; s <= steps; s++) {
      const x = x0 + ((x1 - x0) * s) / steps;
      const y = evalSpline(sp, x);
      if (s === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
  }

  function paintCurve(sp, opts) {
    const { x0, x1, y0, y1 } = G;
    if (opts.glow) {
      ctx.setLineDash([]);
      ctx.strokeStyle = "rgba(52,211,153,0.14)";
      ctx.lineWidth = 9;
      strokeCurve(sp, x0, x1);
    }
    ctx.setLineDash(opts.dash || []);
    if (opts.grad) {
      const g = ctx.createLinearGradient(0, y0, 0, y1);
      g.addColorStop(0, C_ACCENT_HI);
      g.addColorStop(1, C_ACCENT_LOW);
      ctx.strokeStyle = g;
    } else {
      ctx.strokeStyle = opts.color;
    }
    ctx.lineWidth = opts.width;
    strokeCurve(sp, x0, x1);
    ctx.setLineDash([]);
  }

  /* Top-right legend: with three curves on screen the user needs to
     know which stroke is which. */
  function drawLegend(x1, ly) {
    const items = [
      { t: "A", w: 1.8, dash: null, a: 0.82 },
      { t: "B", w: 1.8, dash: [6, 4], a: 0.82 },
      { t: "Z", w: 2.5, dash: null, a: 1 },
    ];
    ctx.font = `10px ${MONO}`;
    ctx.textBaseline = "middle";
    ctx.textAlign = "left";

    let total = 0;
    for (const it of items) total += 17 + ctx.measureText(it.t).width + 15;

    let lx = x1 - total;
    for (const it of items) {
      ctx.save();
      ctx.setLineDash(it.dash || []);
      ctx.lineWidth = it.w;
      ctx.strokeStyle = `rgba(52,211,153,${it.a})`;
      ctx.beginPath();
      ctx.moveTo(lx, ly);
      ctx.lineTo(lx + 17, ly);
      ctx.stroke();
      ctx.restore();
      ctx.fillStyle = C_DIMMER;
      ctx.fillText(it.t, lx + 21, ly);
      lx += 17 + ctx.measureText(it.t).width + 15;
    }
  }

  /* ══════════════════════════════════════════════════════════
     3-D FIELD
     The two operands sit at the far and near ends of a wavetable —
     frame 1 and frame 256 — and the operation's result is the middle
     frame, 128. Three planes in axonometric projection, not 256
     animated frames: the depth axis exists to show the relationship
     between the inputs and the result, not to imply morphing.
     ══════════════════════════════════════════════════════════ */

  function drawField3d(n) {
    const AX = G.x0, BX = G.x1, AY = G.y0, BY = G.y1;
    const cx = (AX + BX) / 2;
    const cy = (AY + BY) / 2;
    const pw = BX - AX, ph = BY - AY;

    /* The planes must be meaningfully smaller than the offset between them,
       or three similar waveforms collapse into one blob. */
    const iw = pw * 0.58, ih = ph * 0.48;    // middle plane
    const dx = pw * 0.14, dy = ph * 0.155;   // depth offset per frame step

    // d = +1 is the far frame, 0 the middle, -1 the near frame.
    /* Appearance is a MONOTONIC function of depth — farther is dimmer and
       thinner — because that is the only cue that actually reads as depth.
       A highlight on one plane inverts the order and flattens the box. */
    const plane = (d) => {
      const s = 1 - d * 0.10;
      const c = (1 - d) / 2;                    // closeness: far 0 → near 1
      return {
        w: iw * s, h: ih * s,
        ox: cx + d * dx, oy: cy - d * dy,
        alpha: 0.30 + 0.55 * c,
        width: 1.1 + 0.9 * c,
        edge: 0.05 + 0.08 * c,
      };
    };

    /* Volume edges first, so they sit behind every plane. The projection is
       linear in d, so the middle plane's corner lies exactly on the line
       between the outer two — one stroke spans all three. */
    const far = plane(1);
    const near = plane(-1);
    ctx.strokeStyle = rgbaToken(C_ACCENT, 0.10);
    ctx.lineWidth = 1;
    for (const sx of [-0.5, 0.5]) {
      for (const sy of [-0.5, 0.5]) {
        ctx.beginPath();
        ctx.moveTo(far.ox + sx * far.w, far.oy + sy * far.h);
        ctx.lineTo(near.ox + sx * near.w, near.oy + sy * near.h);
        ctx.stroke();
      }
    }

    const plate = (reg, d, o) => {
      const p = plane(d);
      const left = p.ox - p.w / 2;
      const top = p.oy - p.h / 2;
      const bottom = p.oy + p.h / 2;

      /* Outline only. Translucent rectangle fills stack additively wherever
         the planes overlap, so the intersections light up and the box reads
         as flat stacked panels rather than as one volume. */
      ctx.strokeStyle = rgbaToken(C_ACCENT, p.edge);
      ctx.lineWidth = 1;
      ctx.strokeRect(left, top, p.w, p.h);

      const xs = new Array(n);
      const ys = new Array(n);
      for (let j = 0; j < n; j++) {
        xs[j] = left + ((j + 0.5) / n) * p.w;
        ys[j] = bottom - (reg.anim[j] / 15) * p.h;
      }
      const sp = buildSpline(xs, ys);

      ctx.lineJoin = "round";
      ctx.lineCap = "round";
      ctx.setLineDash(o.dash || []);
      ctx.strokeStyle = rgbaToken(C_ACCENT, p.alpha);
      ctx.lineWidth = p.width;
      strokeCurve(sp, left, left + p.w);
      ctx.setLineDash([]);

      ctx.font = `10px ${MONO}`;
      ctx.textAlign = "left";
      ctx.textBaseline = "top";
      ctx.fillStyle = rgbaToken(C_DIMMER, 0.50 + 0.45 * ((1 - d) / 2));
      ctx.fillText(o.label, left + 6, top + 5);
    };

    plate(S.A, 1, { label: "1 \u00B7 A" });
    plate(S.Z, 0, { label: "128 \u00B7 Z" });
    plate(S.B, -1, { label: "256 \u00B7 B", dash: [6, 4] });
  }

  /* Ruler, zero-crossing level and the ∞ axis. Drawn after the depth stack
     (so the stack cannot erase them) but before the curves. */
  function drawGuides(x0, x1, y0, y1, cx, cy, yOf) {
    ctx.font = `10px ${MONO}`;
    ctx.textAlign = "right";
    ctx.textBaseline = "middle";
    for (const v of [0, 4, 8, 12, 15]) {
      const y = Math.round(yOf(v)) + 0.5;
      ctx.strokeStyle = "rgba(255,255,255,0.04)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x0, y);
      ctx.lineTo(x1, y);
      ctx.stroke();
      ctx.fillStyle = C_DIMMER;
      ctx.fillText(v.toString(16).toUpperCase(), x0 - 9, y);
    }

    ctx.setLineDash([2, 5]);
    ctx.strokeStyle = "rgba(245,181,68,0.26)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, Math.round(cy) + 0.5);
    ctx.lineTo(x1, Math.round(cy) + 0.5);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.strokeStyle = "rgba(245,181,68,0.10)";
    ctx.beginPath();
    ctx.moveTo(Math.round(cx) + 0.5, y0);
    ctx.lineTo(Math.round(cx) + 0.5, y1);
    ctx.stroke();
  }

  function draw() {
    if (!VW || !VH) return;

    const narrow = VW < 680;
    const padX = narrow ? 16 : 40;
    const padT = 34;
    const padB = 26;

    const x0 = padX;
    const x1 = Math.max(x0 + 10, VW - padX);
    const y0 = padT;
    const y1 = Math.max(y0 + 10, VH - padB);
    const pw = x1 - x0;
    const ph = y1 - y0;

    G.x0 = x0; G.x1 = x1; G.y0 = y0; G.y1 = y1; G.pw = pw; G.ph = ph;

    /* Column geometry — computed once here and pushed to the strip,
       so every control point sits dead centre over its bit cells. */
    const n = nibCount();
    const nibGap = Math.max(1.5, Math.min(12, (pw / n) * 0.16));
    const nibW = (pw - (n - 1) * nibGap) / n;
    G.nibW = nibW;
    G.nibGap = nibGap;
    const gapPx = nibGap.toFixed(2) + "px";
    if (nibsEl.style.gap !== gapPx) nibsEl.style.gap = gapPx;

    /* Below ~46px per nibble the four bit glyphs stop being legible,
       so drop to a hex-only strip rather than overlapping digits.
       The weight row thins out, so the strip must re-render on change. */
    const compact = pw / n < 46;
    if (S.compact !== compact) {
      S.compact = compact;
      stripEl.classList.toggle("compact", compact);
      renderStrip();
    }

    const yOf = (v) => y1 - (v / 15) * ph;
    const cx = (x0 + x1) / 2;
    const cy = yOf(7.5);

    ctx.clearRect(0, 0, VW, VH);

    /* control points — these mirror the bit strip's nibble groups */
    const xs = new Array(n);
    for (let j = 0; j < n; j++) xs[j] = x0 + j * (nibW + nibGap) + nibW / 2;

    const spFor = (r) => buildSpline(xs, r.anim.map(yOf));

    ctx.lineJoin = "round";
    ctx.lineCap = "round";

    const ek = editKey();
    let handleSp = null;

    if (S.view3d) {
      /* The field is self-contained: no ruler, no handles, no ∞ marker. */
      drawField3d(n);
      G.spA = null;
      G.spB = null;
    } else {
      drawGuides(x0, x1, y0, y1, cx, cy, yOf);
    }

    if (S.view3d) {
      /* nothing further — the field is complete */
    } else if (!S.showB) {
      const spA = spFor(S.A);
      G.spA = spA;
      G.spB = null;
      paintCurve(spA, { width: 2.2, grad: true, glow: true });
      handleSp = spA;
    } else {
      const spA = spFor(S.A);
      const spB = spFor(S.B);
      const spZ = spFor(S.Z);
      G.spA = spA;
      G.spB = spB;

      /* The operand you can edit outweighs its mode-mate, so the
         instrument always shows you where your hands are. */
      paintCurve(spA, {
        width: ek === "a" ? 1.8 : 1.3,
        dash: null,
        color: `rgba(52,211,153,${ek === "a" ? 0.82 : 0.3})`,
      });
      paintCurve(spB, {
        width: ek === "b" ? 1.8 : 1.3,
        dash: [6, 4],
        color: `rgba(52,211,153,${ek === "b" ? 0.82 : 0.3})`,
      });
      paintCurve(spZ, { width: 2.5, grad: true, glow: true });

      drawLegend(x1, y0 + 8);
      handleSp = ek === "b" ? spB : spA;
    }

    /* handles — only on the operand you can actually edit */
    const dense = n > 32;
    for (let j = 0; handleSp && j < n; j++) {
      const active =
        (S.drag === j && S.hoverReg === ek) ||
        (S.drag < 0 && S.hoverReg === ek && S.hoverJ === j);
      if (!active && dense) continue;

      const x = xs[j];
      const y = handleSp.ys[j];
      const r = active ? 4.4 : 2.5;

      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = active ? C_HANDLE_HI : "rgba(52,211,153,0.8)";
      ctx.fill();

      if (active) {
        ctx.beginPath();
        ctx.arc(x, y, r + 4, 0, Math.PI * 2);
        ctx.strokeStyle = "rgba(52,211,153,0.4)";
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
    }

    /* In 3-D there is nothing to hover: the field is read-only.
       Returning here also skips the ∞ marker, which the field replaces. */
    if (S.view3d) return;

    /* Hover readout — the nibble's quantitative potential at its position:
       value × 2^weight. At the LSB this reads "n × 2^0", i.e. just n. */
    if (S.hoverJ >= 0 && S.hoverReg === ek) {
      const j = S.hoverJ;
      const v = regOf(ek).target[j];
      const txt = `${v} \u00D7 2^${nibWeightPow(j)}`;
      const hx = Math.min(x1 - 44, Math.max(x0 + 44, xs[j]));
      const hy = Math.max(y0 + 13, handleSp.ys[j] - 15);

      ctx.font = `10px ${MONO}`;
      ctx.textAlign = "center";
      ctx.textBaseline = "bottom";
      ctx.fillStyle = C_HANDLE_HI;
      ctx.fillText(txt, hx, hy);
      ctx.textAlign = "left";
    }

    /* ∞ marker */
    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, 7.5, 0, Math.PI * 2);
    ctx.strokeStyle = "rgba(245,181,68,0.45)";
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(cx, cy, 2.6, 0, Math.PI * 2);
    ctx.fillStyle = "rgba(245,181,68,0.95)";
    ctx.fill();

    ctx.font = `600 14px ${MONO}`;
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "rgba(245,181,68,0.85)";
    ctx.fillText("∞", cx + 14, cy);
    ctx.restore();
  }

  /* ══════════════════════════════════════════════════════════
     RENDER — bit strip
     ══════════════════════════════════════════════════════════ */

  const stripEl = document.getElementById("strip");
  const nibsEl = document.getElementById("nibs");
  const metaEl = document.getElementById("meta");
  const truthEl = document.getElementById("truth");
  const hexEl = document.getElementById("hex");
  const decEl = document.getElementById("dec");
  const hexAEl = document.getElementById("hexA");
  const hexBEl = document.getElementById("hexB");
  const hexZEl = document.getElementById("hexZ");
  const popEl = document.getElementById("pop");
  const trendEl = document.getElementById("trend");

  /* The strip always shows the register you are editing. */
  function renderStrip() {
    const r = editReg();
    const n = nibCount();
    const compact = S.compact;

    const midA = S.N / 2 - 1;
    const midB = S.N / 2;

    let html = "";
    for (let j = 0; j < n; j++) {
      const base = S.N - 1 - 4 * j;
      const v = nibValue(r, j);

      html += `<div class="nib" data-j="${j}"><div class="bits">`;
      for (let k = 0; k < 4; k++) {
        const b = base - k;
        const cls = [
          "bit",
          r.bits[b] ? "on" : "",
          (b === midA || b === midB) ? "mid" : "",
        ].join(" ").trim();
        html += `<i class="${cls}" data-b="${b}">${r.bits[b]}</i>`;
      }
      html += `</div>`;
      html += `<div class="hex">${v.toString(16).toUpperCase()}</div>`;
      html += `<div class="dec">${v}</div>`;

      /* At 256-bit density a weight under every column would collide, so
         mark every 8th nibble plus the LSB — the scale still reads, and the
         ratio between marks is always 2^32. */
      const showWt = !compact || j % 8 === 0 || j === n - 1;
      html += `<div class="wt">${showWt ? "2^" + nibWeightPow(j) : ""}</div>`;
      html += `</div>`;
    }
    nibsEl.innerHTML = html;
    stripEl.dataset.edit = editKey().toUpperCase();
    syncHoverClasses();
  }

  function patchNibble(j) {
    const r = editReg();
    const el = nibsEl.querySelector(`.nib[data-j="${j}"]`);
    if (!el) return;
    const base = S.N - 1 - 4 * j;
    const cells = el.querySelectorAll(".bit");
    for (let k = 0; k < 4; k++) {
      const b = base - k;
      cells[k].textContent = r.bits[b];
      cells[k].classList.toggle("on", !!r.bits[b]);
    }
    const v = nibValue(r, j);
    el.querySelector(".hex").textContent = v.toString(16).toUpperCase();
    const dec = el.querySelector(".dec");
    if (dec) dec.textContent = v;
  }

  function syncHoverClasses() {
    const kids = nibsEl.children;
    for (let j = 0; j < kids.length; j++) {
      kids[j].classList.toggle("hot", j === S.hoverJ && S.hoverReg === editKey());
    }
  }

  /* ══════════════════════════════════════════════════════════
     READOUTS
     ══════════════════════════════════════════════════════════ */

  function toHexOf(r) {
    const n = nibCount();
    let s = "";
    for (let j = 0; j < n; j++) s += nibValue(r, j).toString(16).toUpperCase();
    return s;
  }

  function toDecimalOf(r) {
    let v = 0n;
    for (let b = S.N - 1; b >= 0; b--) v = (v << 1n) | BigInt(r.bits[b]);
    return v.toString();
  }

  const OPSYM = { and: "∧", or: "∨", xor: "⊕", add: "+", sub: "\u2212" };
  const PAIRS = [[0, 0], [0, 1], [1, 0], [1, 1]];

  const binFn = (a, b) =>
    S.binop === "and" ? (a & b) : S.binop === "or" ? (a | b) : (a ^ b);

  /* The truth table is live data: the `n` column counts how many bit
     positions in A and B actually hold each input pair, so the four
     counts always sum to the register width. */
  function renderTruth() {
    /* Arithmetic has no four-row truth table: the result depends on the
       whole word through the carry/borrow, not on the bit pair. */
    if (isArith()) {
      const a = regToBig(S.A);
      const b = regToBig(S.B);
      const over = S.binop === "add"
        ? (a + b) >= (1n << BigInt(S.N))
        : a < b;
      const label = S.binop === "add" ? "carry out" : "borrow out";
      truthEl.innerHTML =
        `<div class="truth-h">A ${OPSYM[S.binop]} B → Z</div>` +
        `<div class="truth-grid ar">` +
        `<span class="th">${label}</span>` +
        `<span class="ct${over ? " yes" : ""}">${over ? "yes" : "no"}</span>` +
        `</div>`;
      return;
    }

    const counts = [0, 0, 0, 0];
    for (let i = 0; i < S.N; i++) {
      counts[(S.A.bits[i] << 1) | S.B.bits[i]]++;
    }

    let html = `<div class="truth-h">A ${OPSYM[S.binop]} B → Z</div>`;
    html += `<div class="truth-grid">`;
    html += `<span class="th">a</span><span class="th">b</span><span class="th">→</span><span class="th">n</span>`;
    for (const [a, b] of PAIRS) {
      const z = binFn(a, b);
      html += `<span>${a}</span><span>${b}</span>`;
      html += `<span class="z${z ? " on" : ""}">${z}</span>`;
      html += `<span class="ct">${counts[(a << 1) | b]}</span>`;
    }
    html += `</div>`;
    truthEl.innerHTML = html;
  }

  function updateReadouts(withDecimal = true) {
    /* The truth table is exactly the right companion to the 3-D field. */
    metaEl.classList.toggle("ab", S.showB);
    stripEl.dataset.edit = editKey().toUpperCase();

    if (S.showB) {
      hexAEl.textContent = toHexOf(S.A);
      hexBEl.textContent = toHexOf(S.B);
      hexZEl.textContent = toHexOf(S.Z);
      let pop = 0;
      for (let i = 0; i < S.N; i++) pop += S.Z.bits[i];
      popEl.textContent = String(pop);
      renderTruth();
    } else {
      hexEl.textContent = toHexOf(S.A);
      if (withDecimal) {
        const d = toDecimalOf(S.A);
        decEl.textContent = d;
        decEl.title = d;
      }
    }

    /* Endpoint trend of the register being edited. */
    const r = editReg();
    const n = nibCount();
    const diff = r.target[n - 1] - r.target[0];
    trendEl.classList.toggle("flat", diff === 0);
    trendEl.textContent = diff < 0 ? "step-down" : diff > 0 ? "step-up" : "level";
  }

  function commit(instant = false) {
    syncTarget(S.A, instant);
    syncTarget(S.B, instant);
    recomputeZ(instant);
    renderStrip();
    updateReadouts();
  }

  /* ══════════════════════════════════════════════════════════
     INTERACTION — canvas drag
     ══════════════════════════════════════════════════════════ */

  function nearestNibble(px) {
    const n = nibCount();
    const { x0, nibW, nibGap } = G;
    let best = -1;
    let bestD = Infinity;
    for (let j = 0; j < n; j++) {
      const x = x0 + j * (nibW + nibGap) + nibW / 2;
      const d = Math.abs(x - px);
      if (d < bestD) { bestD = d; best = j; }
    }
    return best;
  }

  /* With two operands live, grabbing picks whichever curve is nearer
     the pointer — the instrument should never make you hunt for a knob. */
  function nearestReg(px, py) {
    if (!S.showB || S.view3d) return editKey();
    const ya = G.spA ? evalSpline(G.spA, px) : Infinity;
    const yb = G.spB ? evalSpline(G.spB, px) : Infinity;
    return Math.abs(py - ya) <= Math.abs(py - yb) ? "a" : "b";
  }

  function valueFromY(py) {
    const v = ((G.y1 - py) / G.ph) * 15;
    return Math.max(0, Math.min(15, Math.round(v)));
  }

  function setFromPointer(e) {
    if (S.view3d) return;            // the field view is read-only
    const r = canvas.getBoundingClientRect();
    const px = e.clientX - r.left;
    const py = e.clientY - r.top;

    if (S.drag < 0) {
      const j = nearestNibble(px);
      if (j < 0) return;
      S.drag = j;
      S.hoverReg = nearestReg(px, py);
      S.hoverJ = j;
      S.edit = S.hoverReg;
      syncEditUi();
      if (S.edit === "b") renderStrip();
      canvas.classList.add("grabbing");
      document.getElementById("hint").classList.add("off");
    }

    const k = S.hoverReg || editKey();
    const reg = regOf(k);
    const v = valueFromY(py);
    setNibValue(reg, S.drag, v);
    reg.target[S.drag] = v;
    reg.anim[S.drag] = v;            // 1:1 tracking while dragging
    recomputeZ();
    S.Z.anim = S.Z.target.slice();   // results follow the drag exactly
    patchNibble(S.drag);
    updateReadouts(false);
  }

  canvas.addEventListener("pointerdown", (e) => {
    // Throws if the pointer is not active (released early, or synthetic).
    try { canvas.setPointerCapture(e.pointerId); } catch (_) { /* non-fatal */ }
    setFromPointer(e);
  });

  canvas.addEventListener("pointermove", (e) => {
    if (S.view3d) return;
    const r = canvas.getBoundingClientRect();
    if (S.drag >= 0) { setFromPointer(e); return; }

    const px = e.clientX - r.left;
    const j = nearestNibble(px);
    const k = nearestReg(px, e.clientY - r.top);
    if (j !== S.hoverJ || k !== S.hoverReg) {
      S.hoverJ = j;
      S.hoverReg = k;
      syncHoverClasses();
    }
  });

  function endDrag(e) {
    if (S.drag < 0) return;
    S.drag = -1;
    canvas.classList.remove("grabbing");
    updateReadouts(true);
    if (e && canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
  }

  canvas.addEventListener("pointerup", endDrag);
  canvas.addEventListener("pointercancel", endDrag);
  canvas.addEventListener("pointerleave", () => {
    if (S.drag < 0 && S.hoverJ !== -1) {
      S.hoverJ = -1;
      S.hoverReg = null;
      syncHoverClasses();
    }
  });

  /* bit strip: click a bit to flip it, hover to highlight the nibble */
  nibsEl.addEventListener("click", (e) => {
    const bit = e.target.closest(".bit");
    if (!bit) return;
    const reg = editReg();
    const b = Number(bit.dataset.b);
    reg.bits[b] ^= 1;
    const j = Math.floor((S.N - 1 - b) / 4);
    reg.target[j] = nibValue(reg, j);
    recomputeZ();
    patchNibble(j);
    updateReadouts();
  });

  nibsEl.addEventListener("pointerover", (e) => {
    const nib = e.target.closest(".nib");
    const j = nib ? Number(nib.dataset.j) : -1;
    if (j !== S.hoverJ || S.hoverReg !== editKey()) {
      S.hoverJ = j;
      S.hoverReg = j >= 0 ? editKey() : null;
      syncHoverClasses();
    }
  });

  nibsEl.addEventListener("pointerleave", () => {
    if (S.hoverJ !== -1) {
      S.hoverJ = -1;
      S.hoverReg = null;
      syncHoverClasses();
    }
  });

  /* ══════════════════════════════════════════════════════════
     LFO — a stepped modulation source for the edit register.

     It mutates, but never destroys: the pre-LFO bits are snapshotted on
     start and restored on stop, so the register you hand it is the
     register you get back. Every tick is a REAL register state, which
     means the hex, the strip, the truth table and Z stay truthful —
     unlike a fractional-phase animation, which would draw states the
     hardware can never hold.
     ══════════════════════════════════════════════════════════ */

  const lfoBtn = document.getElementById("lfoBtn");
  const lfoModeSel = document.getElementById("lfoMode");
  const lfoRateSel = document.getElementById("lfoRate");
  const amountSel = document.getElementById("amount");
  const lfoBSel = document.getElementById("lfoB");

  function lfoBConfig() {
    const v = lfoBSel.value;
    const frac = v === "q" ? 0.25 : v === "h" ? 0.5 : 0;
    return { opp: v === "opp", off: Math.round(S.N * frac) };
  }

  function lfoStart() {
    if (S.lfo.on) return;
    /* Snapshot BOTH operands: the interference lives in Z, so both have to
       move and both have to come back. */
    S.lfo.base = { a: S.A.bits.slice(), b: S.showB ? S.B.bits.slice() : null };
    S.lfo.t = 0;
    S.lfo.on = true;
    S.lfoAcc = 0;
    lfoBtn.setAttribute("aria-pressed", "true");
  }

  function lfoStop() {
    if (!S.lfo.on) return;
    S.lfo.on = false;
    lfoBtn.setAttribute("aria-pressed", "false");
    const snap = S.lfo.base;
    if (snap) {
      S.A.bits = snap.a.slice();
      if (snap.b) S.B.bits = snap.b.slice();
      S.lfo.base = null;
      commit();
    }
  }

  /* Rotate (wrapping) or truncate a snapshot by a SIGNED bit count. */
  function sweepInto(reg, baseBits, bits, rotate) {
    const N = S.N;
    const out = new Uint8Array(N);
    if (rotate) {
      const sh = ((bits % N) + N) % N;
      for (let i = 0; i < N; i++) out[(i + sh) % N] = baseBits[i];
    } else {
      for (let i = 0; i < N; i++) {
        const d = i + bits;
        if (d >= 0 && d < N) out[d] = baseBits[i];
      }
    }
    reg.bits = out;
  }

  function lfoTick() {
    const base = S.lfo.base;
    if (!base) return;

    const k = Math.max(1, Number(amountSel.value) || 4);
    const rotate = S.lfo.mode !== "slide";
    S.lfo.t++;
    const t = S.lfo.t;

    let shift;
    if (rotate) {
      shift = t * k * (S.lfo.mode === "rotccw" ? -1 : 1);
    } else {
      const maxSteps = Math.max(1, Math.ceil(S.N / k));
      const p = t % (2 * maxSteps);
      shift = (p <= maxSteps ? p : 2 * maxSteps - p) * k;
    }

    sweepInto(S.A, base.a, shift, rotate);
    if (base.b) {
      const cfg = lfoBConfig();
      /* Counter-rotation is the only offset that makes Z *change shape*;
         a fixed offset just slides a rigid pattern around the register. */
      sweepInto(S.B, base.b, (cfg.opp ? -shift : shift) + cfg.off, rotate);
    }

    commit();
  }

  lfoBtn.addEventListener("click", () => (S.lfo.on ? lfoStop() : lfoStart()));

  lfoModeSel.addEventListener("change", () => {
    S.lfo.mode = lfoModeSel.value;
    if (S.lfo.on) { S.lfo.t = 0; }        // restart the shape cleanly
  });

  lfoRateSel.addEventListener("change", () => {
    S.lfo.rate = Number(lfoRateSel.value) || 4;
    S.lfoAcc = 0;
  });

  const clampNib = (v) => Math.max(0, Math.min(15, Math.round(v)));

  const TABLES = {
    zero:     () => 0,
    max:      () => 15,
    sine:     (n, j) => clampNib(7.5 + 7.5 * Math.sin((2 * Math.PI * j) / n)),
    cosine:   (n, j) => clampNib(7.5 + 7.5 * Math.cos((2 * Math.PI * j) / n)),
    triangle: (n, j) => {
      const t = n === 1 ? 0 : j / (n - 1);
      return clampNib(15 * (1 - Math.abs(2 * t - 1)));
    },
    sawDown:  (n, j) => clampNib(15 * (1 - j / Math.max(1, n - 1))),
    sawUp:    (n, j) => clampNib(15 * (j / Math.max(1, n - 1))),
    square:   (n, j) => (j < n / 2 ? 15 : 0),
  };

  function applyTable(name, reg = editReg()) {
    const n = nibCount();
    const fn = TABLES[name];
    if (!fn) return;
    for (let j = 0; j < n; j++) setNibValue(reg, j, fn(n, j));
    commit();
  }

  /* ══════════════════════════════════════════════════════════
     OPS — all unary ops act on the register you are editing
     ══════════════════════════════════════════════════════════ */

  function rotateLeft(r, k) {
    k = ((k % S.N) + S.N) % S.N;
    const next = new Uint8Array(S.N);
    for (let b = 0; b < S.N; b++) next[(b + k) % S.N] = r.bits[b];
    r.bits = next;
  }

  function rotateRight(r, k) {
    k = ((k % S.N) + S.N) % S.N;
    const next = new Uint8Array(S.N);
    for (let b = 0; b < S.N; b++) next[(b - k + S.N) % S.N] = r.bits[b];
    r.bits = next;
  }

  function shiftLeft(r, k) {
    const next = new Uint8Array(S.N);       // bits past the MSB are discarded, not folded
    for (let b = 0; b + k < S.N; b++) next[b + k] = r.bits[b];
    r.bits = next;
  }

  function shiftRight(r, k) {
    const next = new Uint8Array(S.N);
    for (let b = S.N - 1; b - k >= 0; b--) next[b - k] = r.bits[b];
    r.bits = next;
  }

  function invert(r) {
    for (let b = 0; b < S.N; b++) r.bits[b] ^= 1;
  }

  /* XOR against a rising ramp — a wavefolder, and the clearest
     demonstration that bitwise XOR changes harmonic content. */
  function fold(r) {
    const n = nibCount();
    for (let j = 0; j < n; j++) setNibValue(r, j, nibValue(r, j) ^ (j & 15));
  }

  /* Endianness swap: reverse the order of the bytes (nibble pairs).
     Bit order *within* a byte is untouched. No-op at 8 bits, because
     a single byte has no byte order. */
  function byteSwap(r) {
    const n = nibCount();
    const bytes = n >> 1;
    if (bytes < 2) return;
    const cur = new Array(n);
    for (let j = 0; j < n; j++) cur[j] = nibValue(r, j);
    for (let j = 0; j < n; j++) {
      const byteIdx = j >> 1;
      const inByte = j & 1;
      const dest = (bytes - 1 - byteIdx) * 2 + inByte;
      setNibValue(r, dest, cur[j]);
    }
  }

  const OPS = {
    rol:   (r, k) => rotateLeft(r, k),
    ror:   (r, k) => rotateRight(r, k),
    shl:   (r, k) => shiftLeft(r, k),
    shr:   (r, k) => shiftRight(r, k),
    not:   (r) => invert(r),
    fold:  (r) => fold(r),
    bswap: (r) => byteSwap(r),
  };

  document.querySelectorAll("[data-op]").forEach((btn) => {
    btn.addEventListener("click", () => {
      lfoStop();                       // a manual op takes the wheel back
      const k = Number(document.getElementById("amount").value) || 4;
      OPS[btn.dataset.op](editReg(), k);
      commit();
    });
  });

  document.querySelectorAll("[data-preset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      lfoStop();
      applyTable(btn.dataset.preset);
    });
  });

  /* ══════════════════════════════════════════════════════════
     OPERAND B / BINARY LOGIC
     ══════════════════════════════════════════════════════════ */

  const toggleB = document.getElementById("toggleB");
  const editSeg = document.getElementById("editSeg");
  const binopBtns = [...document.querySelectorAll("[data-binop]")];

  function syncEditUi() {
    editSeg.hidden = !S.showB;
    binopBtns.forEach((b) => {
      b.hidden = !S.showB;
      b.classList.toggle("on", b.dataset.binop === S.binop);
    });
    toggleB.setAttribute("aria-pressed", String(S.showB));
    editSeg.querySelectorAll("[data-edit]").forEach((b) => {
      b.classList.toggle("on", b.dataset.edit === editKey());
    });
    stripEl.dataset.edit = editKey().toUpperCase();
  }

  toggleB.addEventListener("click", () => {
    S.showB = !S.showB;
    if (S.showB) {
      S.edit = "b";
      // Seed B the first time so AND/OR/XOR immediately read as masking.
      if (!S.seededB) {
        S.seededB = true;
        applyTable("square", S.B);
      }
    } else {
      S.edit = "a";
    }
    S.hoverReg = null;
    S.hoverJ = -1;
    syncEditUi();
    renderStrip();
    updateReadouts();
  });

  editSeg.querySelectorAll("[data-edit]").forEach((b) => {
    b.addEventListener("click", () => {
      S.edit = b.dataset.edit;
      S.hoverReg = null;
      S.hoverJ = -1;
      syncEditUi();
      renderStrip();
      updateReadouts();
    });
  });

  binopBtns.forEach((b) => {
    b.addEventListener("click", () => {
      S.binop = b.dataset.binop;
      syncEditUi();
      recomputeZ();
      updateReadouts();
    });
  });

  /* ══════════════════════════════════════════════════════════
     VIEW — 2-D canvas vs 3-D depth waterfall
     ══════════════════════════════════════════════════════════ */

  const viewSeg = document.getElementById("viewSeg");
  const hintEl = document.getElementById("hint");

  function syncViewUi() {
    viewSeg.querySelectorAll("[data-view]").forEach((b) => {
      b.classList.toggle("on", (b.dataset.view === "3d") === S.view3d);
    });
    hintEl.textContent = S.view3d
      ? "a and b as frames 1 and 256 \u00B7 result at 128"
      : "drag a nibble up or down";
    if (S.view3d) hintEl.classList.remove("off");
  }

  /* 3-D only means anything with two operands: A and B are the ends of the
     wavetable, so the field view brings B into existence if it isn't there. */
  function enableB() {
    if (S.showB) return;
    S.showB = true;
    S.edit = "b";
    if (!S.seededB) {
      S.seededB = true;
      applyTable("square", S.B);
    }
    syncEditUi();
  }

  viewSeg.querySelectorAll("[data-view]").forEach((b) => {
    b.addEventListener("click", () => {
      S.view3d = b.dataset.view === "3d";
      S.hoverReg = null;
      S.hoverJ = -1;
      if (S.view3d) enableB();
      syncViewUi();
      updateReadouts();
    });
  });

  /* ══════════════════════════════════════════════════════════
     REGISTER SIZE
     ══════════════════════════════════════════════════════════ */

  const sizeInput = document.getElementById("size");
  const sizeOut = document.getElementById("sizeOut");

  function syncSizeLabel() {
    sizeOut.textContent = `${S.N} bits · ${nibCount()} nibbles`;
  }

  sizeInput.addEventListener("input", () => {
    const idx = Number(sizeInput.value);
    resizeRegister(SIZES[idx]);
    syncSizeLabel();
  });

  /* ══════════════════════════════════════════════════════════
     CSV EXAMPLES
     Load a CSV/TSV, pick a column, and step through the rows like
     slides. Columns are classified per-column, because "1011" is
     binary in a flags column and hex in an id column.

     Values are RIGHT-aligned into the register (padded with zeros on
     the left) so a cell's numeric value is preserved: 0xDEAD in a
     64-bit register is 0x000000000000DEAD.
     ══════════════════════════════════════════════════════════ */

  const DEMO = { cols: [], rows: [], colA: -1, colB: -1, i: 0 };

  const csvBtn = document.getElementById("csvBtn");
  const csvFile = document.getElementById("csvFile");
  const stepSeg = document.getElementById("stepSeg");
  const exCount = document.getElementById("exCount");
  const colASel = document.getElementById("colA");
  const colBSel = document.getElementById("colB");
  const prevEx = document.getElementById("prevEx");
  const nextEx = document.getElementById("nextEx");

  /* Minimal RFC4180 reader: quoted fields, doubled quotes, CRLF, and
     comma-or-tab chosen by whichever appears more in the first line. */
  function parseDelimited(text) {
    const t = text.replace(/^\uFEFF/, "");
    const nl = t.indexOf("\n");
    const head = nl === -1 ? t : t.slice(0, nl);
    const tabs = (head.match(/\t/g) || []).length;
    const commas = (head.match(/,/g) || []).length;
    const delim = tabs > commas ? "\t" : ",";

    const rows = [];
    let row = [], field = "", quoted = false;

    for (let i = 0; i < t.length; i++) {
      const c = t[i];
      if (quoted) {
        if (c === '"') {
          if (t[i + 1] === '"') { field += '"'; i++; }
          else quoted = false;
        } else field += c;
      } else if (c === '"') quoted = true;
      else if (c === delim) { row.push(field); field = ""; }
      else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
      else if (c !== "\r") field += c;
    }
    if (field !== "" || row.length) { row.push(field); rows.push(row); }
    return rows;
  }

  const normCell = (raw) =>
    String(raw == null ? "" : raw).trim().replace(/[\s_]/g, "");

  const stripPrefix = (s) => s.replace(/^0[xX]/, "").replace(/^0[bB]/, "");

  const isToken = (s) => /^[0-9a-fA-F]+$/.test(stripPrefix(s));

  function isDataRow(cells) {
    let any = false;
    for (const c of cells) {
      const s = normCell(c);
      if (!s) continue;
      if (!isToken(s)) return false;
      any = true;
    }
    return any;
  }

  /* All-0/1 column → binary; anything with a bigger hex digit → hex. */
  function columnMode(rows, ci) {
    let sawHex = false, sawBin = false;
    for (const r of rows) {
      const s = stripPrefix(normCell(r[ci]));
      if (!s || !isToken(s)) continue;
      if (/^[01]+$/.test(s)) sawBin = true; else sawHex = true;
    }
    return sawHex ? "hex" : sawBin ? "bin" : "hex";
  }

  function cellToBits(raw, mode) {
    const s = stripPrefix(normCell(raw));
    if (!s) return null;

    if (mode === "bin") {
      if (!/^[01]+$/.test(s)) return null;
      return s.split("").map(Number);
    }
    if (!/^[0-9a-fA-F]+$/.test(s)) return null;
    const out = [];
    for (const ch of s) {
      const v = parseInt(ch, 16);
      out.push((v >> 3) & 1, (v >> 2) & 1, (v >> 1) & 1, v & 1);
    }
    return out;
  }

  /* MSB-first bit array into a register, right-aligned. Overflow truncates. */
  function writeBitsInto(reg, arr) {
    reg.bits.fill(0);
    for (let k = 0; k < arr.length; k++) {
      const idx = arr.length - 1 - k;
      if (idx < S.N) reg.bits[idx] = arr[k];
    }
  }

  function columnWidth(ci) {
    const mode = columnMode(DEMO.rows, ci);
    let max = 0;
    for (const r of DEMO.rows) {
      const b = cellToBits(r[ci], mode);
      if (b && b.length > max) max = b.length;
    }
    return max;
  }

  function fitToColumn(ci) {
    let want = SIZES[0];
    for (const s of SIZES) { want = s; if (s >= Math.max(8, columnWidth(ci))) break; }
    if (want !== S.N) {
      resizeRegister(want);
      sizeInput.value = String(SIZES.indexOf(want));
      syncSizeLabel();
    }
  }

  function refreshColumnSelects() {
    const opts = DEMO.cols.map((c, i) => `<option value="${i}">${c}</option>`).join("");
    colASel.innerHTML = opts;
    colBSel.innerHTML = `<option value="-1">—</option>` + opts;
    colASel.value = String(DEMO.colA);
    colBSel.value = String(DEMO.colB);
  }

  function applyExample(idx, instant) {
    if (!DEMO.rows.length) return;
    lfoStop();
    const n = DEMO.rows.length;
    DEMO.i = ((idx % n) + n) % n;
    const row = DEMO.rows[DEMO.i];

    const a = cellToBits(row[DEMO.colA], columnMode(DEMO.rows, DEMO.colA));
    if (a) writeBitsInto(S.A, a);

    if (DEMO.colB >= 0) {
      const b = cellToBits(row[DEMO.colB], columnMode(DEMO.rows, DEMO.colB));
      if (b) writeBitsInto(S.B, b);
    }

    commit(instant === true);
    renderDemoUi();
  }

  function renderDemoUi() {
    const loaded = DEMO.rows.length > 0;
    [stepSeg, exCount, colASel, colBSel].forEach((el) => { el.hidden = !loaded; });
    if (!loaded) return;
    exCount.textContent = `${DEMO.i + 1} / ${DEMO.rows.length}`;
    colASel.value = String(DEMO.colA);
    colBSel.value = String(DEMO.colB);
  }

  function loadCSV(text) {
    const rows = parseDelimited(text).filter((r) => r.some((c) => normCell(c) !== ""));
    if (rows.length < 1) return;

    const hasHeader = !isDataRow(rows[0]);
    const cols = hasHeader
      ? rows[0].map((c, i) => String(c).trim() || `col${i + 1}`)
      : rows[0].map((_, i) => `col${i + 1}`);
    const body = hasHeader ? rows.slice(1) : rows;
    if (!body.length) return;

    DEMO.cols = cols;
    DEMO.rows = body;
    DEMO.i = 0;
    DEMO.colB = -1;

    /* Default to the WIDEST token column, not the first: id/label columns
       are often present and the payload is what you want to see. */
    let best = -1, bestW = -1;
    for (let ci = 0; ci < cols.length; ci++) {
      const w = columnWidth(ci);
      if (w > bestW) { bestW = w; best = ci; }
    }
    DEMO.colA = bestW > 0 ? best : 0;

    fitToColumn(DEMO.colA);
    refreshColumnSelects();
    applyExample(0, true);
  }

  csvBtn.addEventListener("click", () => csvFile.click());

  csvFile.addEventListener("change", () => {
    const f = csvFile.files && csvFile.files[0];
    if (!f) return;
    const rd = new FileReader();
    rd.onload = () => loadCSV(String(rd.result || ""));
    rd.readAsText(f);
    csvFile.value = "";
  });

  prevEx.addEventListener("click", () => applyExample(DEMO.i - 1));
  nextEx.addEventListener("click", () => applyExample(DEMO.i + 1));

  colASel.addEventListener("change", () => {
    DEMO.colA = Number(colASel.value);
    DEMO.colB = -1;
    fitToColumn(DEMO.colA);
    refreshColumnSelects();
    applyExample(0, true);
  });

  colBSel.addEventListener("change", () => {
    DEMO.colB = Number(colBSel.value);
    if (DEMO.colB >= 0 && !S.showB) enableB();
    applyExample(DEMO.i);
  });

  /* Arrow keys step examples when focus isn't in a control. */
  document.addEventListener("keydown", (e) => {
    if (!DEMO.rows.length) return;
    if (/^(INPUT|SELECT|TEXTAREA)$/.test((e.target && e.target.tagName) || "")) return;
    if (e.key === "ArrowRight") { applyExample(DEMO.i + 1); e.preventDefault(); }
    else if (e.key === "ArrowLeft") { applyExample(DEMO.i - 1); e.preventDefault(); }
  });

  /* Drop a file anywhere. */
  document.addEventListener("dragover", (e) => e.preventDefault());
  document.addEventListener("drop", (e) => {
    e.preventDefault();
    const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (!f) return;
    const rd = new FileReader();
    rd.onload = () => loadCSV(String(rd.result || ""));
    rd.readAsText(f);
  });

  /* ══════════════════════════════════════════════════════════
     LOOP
     ══════════════════════════════════════════════════════════ */

  function easeReg(r) {
    const n = nibCount();
    for (let j = 0; j < n; j++) {
      const d = r.anim[j];
      const t = r.target[j];
      const diff = t - d;
      if (Math.abs(diff) < 0.004) r.anim[j] = t;
      else r.anim[j] = d + diff * 0.24;
    }
  }

  let lfoPrev = 0;

  function loop(now) {
    if (!lfoPrev) lfoPrev = now;
    const dt = Math.min(120, Math.max(0, now - lfoPrev));
    lfoPrev = now;

    /* Clamped dt and a bounded catch-up loop: a backgrounded tab must not
       fire hundreds of ticks the moment it is refocused. */
    if (S.lfo.on) {
      S.lfoAcc += dt;
      const interval = 1000 / S.lfo.rate;
      let guard = 0;
      while (S.lfoAcc >= interval && guard++ < 6) {
        S.lfoAcc -= interval;
        lfoTick();
      }
    }

    easeReg(S.A);
    if (S.showB) { easeReg(S.B); easeReg(S.Z); }
    draw();
    requestAnimationFrame(loop);
  }

  /* ══════════════════════════════════════════════════════════
     BOOT
     ══════════════════════════════════════════════════════════ */

  function boot() {
    // Start on a real waveform: the sine table is the clearest proof
    // that register content *is* the wave.
    const n = nibCount();
    for (let j = 0; j < n; j++) setNibValue(S.A, j, TABLES.sine(n, j));
    for (let j = 0; j < n; j++) setNibValue(S.B, j, TABLES.square(n, j));

    syncTarget(S.A, true);
    syncTarget(S.B, true);
    recomputeZ(true);

    syncSizeLabel();
    syncEditUi();
    syncViewUi();
    renderStrip();
    updateReadouts();

    const ro = new ResizeObserver(() => fitCanvas());
    ro.observe(canvas);
    fitCanvas();

    requestAnimationFrame(loop);
  }

  boot();
})();
</script>
</body>
</html>
